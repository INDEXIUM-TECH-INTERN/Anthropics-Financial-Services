{
  "name": "indexium-glass-chat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:docker": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "isomorphic-dompurify": "^2.15.0",
    "marked": "^14.0.0",
    "nanostores": "^1.3.0",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/prismjs": "^1.26.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "knip": {
    "ignore": [
      "vite.config.ts"
    ],
    "ignoreDependencies": [
      "playwright"
    ]
  }
}
